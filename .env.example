# ─────────────────────────────────────────────────────────────────────────────
# Mariposa — environment variables
#
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
# These power the reservation form's two delivery channels. Leaving a channel's
# vars blank simply disables that channel — the form still works, the booking is
# just not forwarded over that path (handy for local development).
# ─────────────────────────────────────────────────────────────────────────────

# ── Sanity CMS (https://www.sanity.io) ──────────────────────────────────────
# Project id and dataset are public (they ship in the client bundle); the values
# below are the real ones for this site and are also hard-coded as defaults in
# src/sanity/env.ts, so the site/Studio build even without this file.
NEXT_PUBLIC_SANITY_PROJECT_ID=te38hur6
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-06-16
# Write token — only needed to import/seed content (scripts/sanity-import.ts) or
# for authenticated reads of a private dataset. Create at
# https://www.sanity.io/manage → project → API → Tokens (Editor role). Keep secret.
SANITY_API_WRITE_TOKEN=

# ── Email delivery — Resend (https://resend.com) ────────────────────────────
# 1. Create a Resend account and add + verify your sending domain.
# 2. Create an API key (Dashboard → API Keys).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be an address on a domain you've verified in Resend, e.g.
# "Mariposa <reservations@mariposa.restaurant>".
RESERVATION_FROM_EMAIL=Mariposa <reservations@mariposa.restaurant>
# Where booking requests are delivered. Defaults to the restaurant's published
# inbox if left unset.
RESERVATION_TO_EMAIL=mariposa.rhodos@gmail.com

# ── WhatsApp delivery — Twilio (https://www.twilio.com/whatsapp) ─────────────
# From the Twilio Console dashboard.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# The WhatsApp-enabled sender. For testing use the Twilio Sandbox number
# (e.g. +14155238886); in production use your approved WhatsApp sender.
# The `whatsapp:` prefix is added automatically if you omit it.
TWILIO_WHATSAPP_FROM=+14155238886
# The restaurant's WhatsApp number that should receive booking notifications,
# in E.164 format.
RESTAURANT_WHATSAPP_TO=+306906489686
